#: includes/admin-page.php:173
#: includes/admin-page.php:359
#: includes/admin-page.php:360
msgid "Block permissions"
msgstr "Blockberechtigungen"

#: includes/admin-page.php:175
msgid "Choose which blocks each role may insert. Administrators always have every block."
msgstr "Wählen Sie aus, welche Blöcke jede Rolle einfügen darf. Administratoren haben immer Zugriff auf alle Blöcke."

#: includes/admin-page.php:179
msgid "Block permissions saved."
msgstr "Blockberechtigungen gespeichert."

#: includes/admin-page.php:185
msgid "Block permissions imported."
msgstr "Blockberechtigungen importiert."

#: includes/admin-page.php:192
msgid "Export"
msgstr "Exportieren"

#: includes/admin-page.php:198
msgid "Block permissions file"
msgstr "Blockberechtigungsdatei"

#: includes/admin-page.php:200
msgid "Import…"
msgstr "Importieren…"

#: includes/admin-page.php:205
msgid "Search blocks"
msgstr "Blöcke suchen"

#: includes/admin-page.php:206
msgid "Search blocks…"
msgstr "Blöcke suchen…"

#: includes/admin-page.php:210
#: includes/admin-page.php:237
msgid "Category"
msgstr "Kategorie"

#: includes/admin-page.php:212
msgid "All categories"
msgstr "Alle Kategorien"

#: includes/admin-page.php:236
msgid "Block"
msgstr "Block"

#: includes/admin-page.php:250
msgid "Not currently registered on this site."
msgstr "Auf dieser Website derzeit nicht registriert."

#: includes/admin-page.php:251
msgid "Unregistered"
msgstr "Nicht registriert"

#. translators: 1: block title, 2: role name.
#: includes/admin-page.php:263
#, php-format
msgid "Allow %1$s for %2$s"
msgstr "%1$s für %2$s erlauben"

#: includes/admin-page.php:335
msgid "You are not allowed to change block permissions."
msgstr "Sie dürfen die Blockberechtigungen nicht ändern."

#: includes/class-plugin-updater.php:475
msgid "Security verification failed: the update manifest could not be loaded, so the package cannot be verified."
msgstr "Sicherheitsprüfung fehlgeschlagen: Das Update-Manifest konnte nicht geladen werden, daher kann das Paket nicht verifiziert werden."

#: includes/class-plugin-updater.php:482
msgid "Security verification failed: the update manifest contains no SHA-256 checksum, so the package cannot be verified."
msgstr "Sicherheitsprüfung fehlgeschlagen: Das Update-Manifest enthält keine SHA-256-Prüfsumme, daher kann das Paket nicht verifiziert werden."

#: includes/class-plugin-updater.php:492
#, php-format
msgid "Download failed: %s"
msgstr "Download fehlgeschlagen: %s"

#. translators: 1: expected SHA-256 hash, 2: calculated SHA-256 hash
#: includes/class-plugin-updater.php:508
#, php-format
msgid "Security verification failed: Plugin checksum mismatch. Expected: %1$s, Got: %2$s"
msgstr "Sicherheitsprüfung fehlgeschlagen: Prüfsumme des Plugins stimmt nicht überein. Erwartet: %1$s, Erhalten: %2$s"

#: includes/import-export.php:84
msgid "The file is not valid JSON."
msgstr "Die Datei ist kein gültiges JSON."

#: includes/import-export.php:92
msgid "This file is not a recognised block permissions export."
msgstr "Diese Datei ist kein erkannter Blockberechtigungs-Export."

#: includes/import-export.php:100
msgid "The file has no roles to import."
msgstr "Die Datei enthält keine zu importierenden Rollen."

#: includes/import-export.php:210
msgid "You are not allowed to export block permissions."
msgstr "Sie dürfen Blockberechtigungen nicht exportieren."

#: includes/import-export.php:228
#: includes/import-export.php:344
msgid "You are not allowed to import block permissions."
msgstr "Sie dürfen Blockberechtigungen nicht importieren."

#: includes/import-export.php:237
msgid "No file was uploaded."
msgstr "Es wurde keine Datei hochgeladen."

#: includes/import-export.php:241
msgid "The uploaded file could not be verified."
msgstr "Die hochgeladene Datei konnte nicht verifiziert werden."

#: includes/import-export.php:247
msgid "The file is larger than the 1 MB limit."
msgstr "Die Datei überschreitet das Limit von 1 MB."

#: includes/import-export.php:253
msgid "The file could not be read."
msgstr "Die Datei konnte nicht gelesen werden."

#: includes/import-export.php:265
msgid "The file could not be re-encoded for confirmation."
msgstr "Die Datei konnte zur Bestätigung nicht neu kodiert werden."

#: includes/import-export.php:277
#: includes/import-export.php:281
msgid "Import preview"
msgstr "Importvorschau"

#. translators: 1: number of roles that will change, 2: number of block entries that will change.
#: includes/import-export.php:288
#, php-format
msgid "%1$d role(s) will change, touching %2$d block permission entry/entries."
msgstr "Es ändern sich %1$d Rolle(n), betroffen sind %2$d Blockberechtigungseintrag/-einträge."

#. translators: %s: comma-separated role slugs.
#: includes/import-export.php:303
#, php-format
msgid "These roles do not exist on this site and will be stored anyway: %s"
msgstr "Diese Rollen existieren auf dieser Website nicht und werden trotzdem gespeichert: %s"

#. translators: %s: comma-separated block names.
#: includes/import-export.php:319
#, php-format
msgid "These blocks are not currently tracked on this site: %s"
msgstr "Diese Blöcke werden auf dieser Website derzeit nicht erfasst: %s"

#: includes/import-export.php:332
msgid "Apply import"
msgstr "Import anwenden"

#: includes/import-export.php:333
msgid "Cancel"
msgstr "Abbrechen"
